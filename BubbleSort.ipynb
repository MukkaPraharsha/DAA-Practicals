     "text": [
      "[-4, 3, 7, 19, 20]\n"
     ]
    }
   ],
   "source": [
    "#Bubble Sort\n",
    "arr=[3,7,19,20,-4]\n",
    "n=len(arr)\n",
    "for i in range(n-1):\n",
    "    for j in range(n - i - 1):\n",
    "        if arr[j] > arr[j + 1]:\n",
    "            temp=arr[j]\n",
    "            arr[j]=arr[j+1]\n",
    "            arr[j+1]=temp\n",
    "print(arr)\n",
    "\" \" \"\n",
    "Time Complexity:O(n²)\n",
    "Space Complexity:O(1)"
   ]
  },
